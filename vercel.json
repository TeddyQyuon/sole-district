{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "storefront": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/client",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/:path*",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config.asgi:application",
      "buildCommand": "python vercel_build.py",
      "functions": {
        "config/asgi.py": {
          "maxDuration": 60,
          "excludeFiles": "{.venv/**,db.sqlite3,.env,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/django"
      }
    },
    {
      "source": "/django-admin/(.*)",
      "destination": {
        "service": "backend",
        "path": "/django"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "storefront",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
