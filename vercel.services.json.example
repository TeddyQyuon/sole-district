{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "storefront": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/client",
      "rewrites": [{ "source": "/:path*", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "config.asgi:application",
      "buildCommand": "python vercel_build.py"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/django-admin/:path*", "destination": { "service": "backend" } },
    { "source": "/static/:path*", "destination": { "service": "backend" } },
    { "source": "/:path*", "destination": { "service": "storefront" } }
  ]
}
