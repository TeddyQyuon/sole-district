# Copy this file to .env for local development. Use real secrets only in a secure host environment.
DJANGO_SECRET_KEY=local-only-change-this-to-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://terminal.local:4173
FRONTEND_ORIGIN=http://localhost:5173

# Leave DATABASE_URL empty to use local SQLite.
# Docker Compose overrides this with the local PostgreSQL service.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0

# First production owner: choose and enter these in protected Vercel settings.
# The bootstrap never replaces an existing owner or changes their password.
# Remove all three variables after the account is created.
SOLE_OWNER_USERNAME=
SOLE_OWNER_EMAIL=
SOLE_OWNER_PASSWORD=

# Payments remain disabled until Stripe is deliberately configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false
LIVE_COMMERCE_ENABLED=false
STORE_POLICIES_APPROVED=false
STORE_SUPPORT_EMAIL=
LIVE_TESTS_CONFIRMED=false

LOW_STOCK_THRESHOLD=3
EVENT_RETENTION_DAYS=180

# SMTP for account verification, password reset and order notifications.
# Run python manage.py send_store_emails periodically.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SOLE DISTRICT <orders@example.invalid>
